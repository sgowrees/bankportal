{
  "info": {
    "name": "Banking Portal Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    }
  ],

  "item": [

    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\":\"testuser1\",\n    \"password\":\"mypassword123\",\n    \"email\":\"testuser1@test.com\"\n}"
        }
      }
    },


    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function(){",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let response = pm.response.json();",
              "pm.collectionVariables.set('token', response.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\":\"testuser1\",\n    \"password\":\"mypassword123\"\n}"
        }
      }
    },


    {
      "name": "Create Account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Account created', function(){",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/create",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"accountType\":\"CHECKING\"\n}"
        }
      }
    },


    {
      "name": "Get Accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get Accounts successful', function(){",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "let accounts = pm.response.json();",
              "",
              "pm.expect(accounts.length).to.be.above(0);",
              "",
              "pm.collectionVariables.set('accountId', accounts[0].accountId);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts"
      }
    },


    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{accountId}}/deposit",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"amount\":200\n}"
        }
      }
    },


    {
      "name": "Withdraw",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{accountId}}/withdraw",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"amount\":100\n}"
        }
      }
    },


    {
      "name": "Transfer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{accountId}}/transfer",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"toAccountId\":2,\n    \"amount\":50\n}"
        }
      }
    },


    {
      "name": "Create Second Account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let account = pm.response.json();",
              "pm.collectionVariables.set('accountId', account.accountId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/accounts/create",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"accountType\":\"CHECKING\"\n}"
        }
      }
    },


    {
      "name": "Remove Account",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/accounts/{{accountId}}"
      }
    }

  ]
}